{
  "builds": [
    { "src": "dist/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/ads.txt", "dest": "/dist/public/ads.txt" },
    { "src": "/robots.txt", "dest": "/dist/public/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/dist/public/sitemap.xml" },
    { "src": "/content_snapshot.json", "dest": "/dist/public/content_snapshot.json" },
    { "src": "/assets/(.*)", "dest": "/dist/public/assets/$1" },
    { "src": "/content/(.*)", "dest": "/dist/public/content/$1" },
    { "src": "/(.*)", "dest": "/dist/public/index.html" }
  ]
}
