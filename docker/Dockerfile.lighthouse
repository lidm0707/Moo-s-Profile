# Lighthouse runner: same production build, same scores PageSpeed Insights uses.
# Chromium comes from Debian's package (Lighthouse launches it via CHROME_PATH).
FROM node:22-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV CHROME_PATH=/usr/bin/chromium
ENV LIGHTHOUSE_REPORT_DIR=/report

# Print Performance / Accessibility / Best Practices / SEO scores when done,
# and write JSON + HTML reports to $LIGHTHOUSE_REPORT_DIR.
CMD ["sh", "-c", "mkdir -p $LIGHTHOUSE_REPORT_DIR && npx -y lighthouse http://web:80 --quiet --output=json --output=html --output-path=$LIGHTHOUSE_REPORT_DIR/lighthouse --chrome-flags=\"--headless --no-sandbox\" && node -e \"const fs=require('fs'),dir=process.env.LIGHTHOUSE_REPORT_DIR;const {categories}=JSON.parse(fs.readFileSync(dir+'/lighthouse.report.json','utf8'));for(const[k,c]of Object.entries(categories))console.log(k.padEnd(18),Math.round(c.score*100))\""]
