# Moo's Profile — environment variables
#
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# `.env` is gitignored and read by build.rs at compile time (via dotenvy).
# Required vars use `.expect` — the build fails until they are set.
# Optional vars fall back to safe defaults.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Required. Runtime mode, e.g. "development" | "production".
APP_MODE=development

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Required. Project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# Required. Anonymous public key (safe for client use; NOT the service role key).
SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Any other SUPABASE_-prefixed vars are forwarded automatically by build.rs,
# e.g. SUPABASE_SERVICE_ROLE_KEY (never commit the service role key).

# ---------------------------------------------------------------------------
# Google AdSense (optional — all default-safe)
# ---------------------------------------------------------------------------
# Optional. Your AdSense publisher id. Replace the X's with your real id
# from the AdSense console (Account information), e.g. ca-pub-3526470154848781.
# IMPORTANT: do NOT leave the placeholder value below uncommented — if
# ADSENSE_CLIENT_ID equals PLACEHOLDER_CLIENT_ID, ads are silently disabled.
# Leave this commented OUT to disable ads, or uncomment and set your real id:
# ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
#
# Optional. Sentinel marking an unset publisher id; the loader skips injection
# while ADSENSE_CLIENT_ID equals this value. Override only for a custom
# placeholder (e.g. a test publisher id). Defaults to the value below.
# PLACEHOLDER_CLIENT_ID=ca-pub-0000000000000000
