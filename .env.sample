# Moo's Profile — environment template.
# Copy this file to `.env` and fill in real values:   cp .env.sample .env
# `.env` is gitignored and read by build.rs at compile time (via dotenvy).
# Required vars use `.expect` — the build fails until they are set.
# Optional vars fall back to safe defaults.

# ─── App ───────────────────────────────────────────────────────────
# Required. Runtime mode: "development" or "production".
APP_MODE=development

# ─── Supabase ──────────────────────────────────────────────────────
# Required. Project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Required. Anonymous public key (safe for client use; NOT the service role key).
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Any other SUPABASE_-prefixed vars are forwarded automatically by build.rs,
# e.g. SUPABASE_SERVICE_ROLE_KEY (NEVER commit the service role key).

# ─── Google AdSense ────────────────────────────────────────────────
# Optional. Publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX, 16 digits after
# ca-pub-). Get from: AdSense console → Account → Account information.
#
# Leave EMPTY to fall back to the ID parsed from index.html (the single
# source of truth for AdSense crawler verification). Set it here ONLY to
# override index.html (e.g. for a test build).
ADSENSE_CLIENT_ID=

# Optional: sentinel that marks an unset publisher id. Ads are disabled at
# runtime when ADSENSE_CLIENT_ID equals this value. Change only if you need a
# non-default sentinel for some tooling.
# PLACEHOLDER_CLIENT_ID=ca-pub-0000000000000000

# Optional: sentinel that marks an unset ad slot id. The Adsense component
# refuses to render when ad_slot equals this value or is empty. Change only
# if you need a non-default sentinel for some tooling.
# PLACEHOLDER_AD_SLOT=0000000000
